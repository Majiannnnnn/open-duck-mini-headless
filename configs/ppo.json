{
  "description": "From-scratch six-direction gait (forward/backward, left/right, turn left/right) with direction changes and stops; one 24-32 GB GPU",
  "ppo": {
    "num_timesteps": 655360000,
    "num_evals": 11,
    "num_envs": 8192,
    "num_eval_envs": 192,
    "num_resets_per_eval": 0,
    "episode_length": 650,
    "action_repeat": 1,
    "unroll_length": 40,
    "batch_size": 1024,
    "num_minibatches": 8,
    "num_updates_per_batch": 4,
    "discounting": 0.99,
    "learning_rate": 0.0003,
    "learning_rate_schedule": "ADAPTIVE_KL",
    "learning_rate_schedule_min_lr": 1e-05,
    "learning_rate_schedule_max_lr": 0.0003,
    "desired_kl": 0.01,
    "clipping_epsilon": 0.2,
    "entropy_cost": 0.005,
    "max_grad_norm": 1.0,
    "reward_scaling": 1.0,
    "normalize_observations": true,
    "deterministic_eval": true,
    "seed": 20261028,
    "log_training_metrics": true,
    "training_metrics_steps": 3276800
  },
  "network": {
    "activation": "silu",
    "policy_hidden_layer_sizes": [
      512,
      256,
      128
    ],
    "value_hidden_layer_sizes": [
      512,
      256,
      128
    ],
    "policy_obs_key": "state",
    "value_obs_key": "privileged_state",
    "distribution_type": "tanh_normal",
    "noise_std_type": "scalar",
    "init_noise_std": 1.0,
    "state_dependent_std": false,
    "mean_clip_scale": null,
    "use_distributional_critic": false
  }
}
